{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/details/**",
      "destination": "/app.html"
    },
    {
      "source": "/admin",
      "destination": "/app.html"
    },
    {
      "source": "/admin/**",
      "destination": "/app.html"
    },
    {
      "source": "/login",
      "destination": "/app.html"
    }
  ]
}
