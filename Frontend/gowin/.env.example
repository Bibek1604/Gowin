# Copy to .env and fill in the values from Supabase → Project Settings → API.
# The anon key is public by design (it ships in the browser); row-level
# security in the database is what protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: public site URL used for canonical links and the sitemap.
VITE_SITE_URL=https://gowintravels.com

# Optional: extra client-side gate — comma-separated emails allowed into /admin.
# Server-side access is controlled by the admin_users table.
# VITE_ADMIN_EMAILS=owner@example.com
